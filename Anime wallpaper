'use client';

import { useEffect, useState } from 'react';

export default function Home() {
  const [wallpapers, setWallpapers] = useState([]);

  useEffect(() => {
    fetch('/api/wallpapers')
      .then((res) => res.json())
      .then((data) => setWallpapers(data))
      .catch(console.error);
  }, []);

  return (
    <main style={{ background: '#111', minHeight: '100vh', color: '#fff' }}>
      <section
        style={{
          textAlign: 'center',
          padding: '80px 20px',
          background:
            'linear-gradient(rgba(0,0,0,.6), rgba(0,0,0,.6)), url(https://wallhaven.cc/wallpapers/full/wallhaven-4g6q5l.jpg)',
          backgroundSize: 'cover',
          backgroundPosition: 'center',
        }}
      >
        <h1 style={{ fontSize: '3rem' }}>Anime Wallpapers Hub</h1>

        <p style={{ marginTop: '20px' }}>
          Download HD, 4K and Live Anime Wallpapers
        </p>
      </section>

      <section style={{ padding: '40px' }}>
        <h2>Trending Wallpapers</h2>

        <div
          style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(auto-fill,minmax(250px,1fr))',
            gap: '20px',
            marginTop: '20px',
          }}
        >
          {wallpapers.map((wallpaper: any) => (
            <div
              key={wallpaper.id}
              style={{
                background: '#222',
                borderRadius: '10px',
                overflow: 'hidden',
              }}
            >
              <img
                src={wallpaper.thumbs?.large}
                alt=""
                style={{
                  width: '100%',
                  height: '350px',
                  objectFit: 'cover',
                }}
              />

              <div style={{ padding: '15px' }}>
                <p>{wallpaper.resolution}</p>

                <a
                  href={wallpaper.path}
                  target="_blank"
                  rel="noreferrer"
                  style={{
                    display: 'inline-block',
                    marginTop: '10px',
                    background: '#ff4757',
                    padding: '10px 15px',
                    borderRadius: '5px',
                    color: '#fff',
                    textDecoration: 'none',
                  }}
                >
                  Download
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
  );
}
